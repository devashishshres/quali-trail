# Names and placeholders only. Copy to .env.local and fill in real values there.
# NEVER commit real keys. Provider keys are server-only: never prefix them with NEXT_PUBLIC_.

# "live" uses Supabase, Supermemory and Gemini. "fixtures" shows labelled sample data with no services.
NEXT_PUBLIC_DATA_MODE=live

# Supabase project URL: the bare project URL, without /rest/v1/.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (anon) key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service-role) key. SERVER ONLY. Used by API routes after they authenticate the user, and by seed scripts.
SUPABASE_SECRET_KEY=

# Gemini document extraction. SERVER ONLY.
GEMINI_API_KEY=
# Optional. Leave both unset to use the built-in order: gemini-3.5-flash-lite, gemini-3.5-flash, gemini-3.1-flash-lite.
# GEMINI_MODEL=
# GEMINI_FALLBACK_MODELS=

# Supermemory professional memory. SERVER ONLY.
SUPERMEMORY_API_KEY=
# Optional prefix that keeps this deployment's memories separate from another project's. Changing it later orphans
# memories already stored under the old prefix.
# SUPERMEMORY_NAMESPACE_PREFIX=qualitrail_our_version_

# Seed scripts only (never read by the app).
DEMO_USER_PASSWORD=
# DEMO_USER_EMAIL=
# DEMO_WORKER_SLUG=
# DEMO_WORKER_NAME=
# DEMO_WORKER_SUMMARY=

# ---------------------------------------------------------------------------------------------------
# Accounts, email, customer sign-off and supervisor review. ALL SERVER ONLY. Defaults keep everything off.
# ---------------------------------------------------------------------------------------------------
# Who may create an account: closed (default; invited supervisors only) | allowlist | open
# SIGNUP_MODE=closed
# Comma-separated exact addresses and/or @domains, used when SIGNUP_MODE=allowlist
# SIGNUP_ALLOWLIST=
# Feature flags. Turning one off stops new activity; completed acknowledgments and reviews stay visible.
# SIGNOFF_ENABLED=false
# SUPERVISOR_REVIEW_ENABLED=false
# off (default): nothing is sent. mock: SIMULATED delivery to a local git-ignored outbox, refused unless the app
# and Supabase both run on localhost and not on Vercel.
# resend: real email; refuses to send unless every RESEND_* variable and APP_BASE_URL are set.
# EMAIL_MODE=off
# REQUIRED even with every feature off (sign-up, password reset and onboarding use it for rate limits).
# Random secret, at least 32 characters, used to hash tokens, codes, sessions and addresses. Generate once per
# environment and keep it: changing it invalidates open invitations and loses opt-out matching.
# SIGNOFF_PEPPER=
# Public base URL of the app (no trailing slash), used in email links, e.g. http://localhost:3000
# APP_BASE_URL=
# RESEND_API_KEY=
# Verified sender on the sending subdomain, e.g. QualiTrail <notify@mail.example.com>
# RESEND_FROM=
# Webhook signing secret from Resend (delivery, bounce and complaint events post to /api/webhooks/resend).
# RESEND_WEBHOOK_SECRET=
